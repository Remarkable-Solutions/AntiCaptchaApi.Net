<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFrameworks>net8.0;net9.0;netstandard2.1;</TargetFrameworks>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <Version>2.2.0</Version>
    <Authors>RemarkableSolutions</Authors>
    <PackageProjectUrl>https://github.com/RemarkableSolutionsAdmin/AntiCaptchaApi.Net</PackageProjectUrl>
    <GeneratePackageOnBuild>True</GeneratePackageOnBuild>
    <RepositoryUrl>https://github.com/RemarkableSolutionsAdmin/AntiCaptchaApi.Net</RepositoryUrl>
    <PackageTags>AntiCaptcha Captcha Recaptcha GeeCaptcha RecaptchaV2 Anti-captcha RemarkableSolutions CaptchaSolver Solver</PackageTags>
    <Title>Anticaptcha.NetStandard</Title>
    <Description>Library for captcha solving using anti-captcha.com api</Description>
    <Copyright>Copyright (c) Remarkable Solutions 2022</Copyright>
    <AssemblyName>$(MSBuildProjectName)</AssemblyName>
    <PublishRepositoryUrl>True</PublishRepositoryUrl>
    <IncludeSymbols>True</IncludeSymbols>
    <SymbolPackageFormat>snupkg</SymbolPackageFormat>
    <PackageVersion>2.2.0</PackageVersion>
    <PackageReleaseNotes>
      2.2.0:
      - Fixed: Amazon WAF task creation, reCAPTCHA v3 validation (IsEnterprise, MinScore 0.9), Turnstile proxy validation, Prosopo/Friendly Captcha/Amazon WAF result parsing, concurrent-solve race, proxy port 65535, polling through transient network errors, no retry of invalid requests, DI HTTP timeout, AntiGate HTMLsInBase64.
      - Added: AntiGateRequest (AntiGateTask) and more AntiGateSolution fields.
      - Security: clientKey and proxyPassword are redacted from RawPayload.
      - Changed: dependency floors lowered to Microsoft.Extensions.Http 8.0.0 and Newtonsoft.Json 13.0.1.
      - Deprecated: ReportOutcome.IncorrectHCaptcha, RecaptchaV3Request.MinScore 0.5 (removal in 3.0).
      Full history: CHANGELOG.md - https://github.com/RemarkableSolutionsAdmin/AntiCaptchaApi.Net/blob/main/CHANGELOG.md
    </PackageReleaseNotes>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.0" />
    <PackageReference Include="Newtonsoft.Json" Version="13.0.1" />
  </ItemGroup>

  <ItemGroup>
    <AssemblyAttribute Include="System.Runtime.CompilerServices.InternalsVisibleToAttribute">
      <_Parameter1>AntiCaptchaApi.Net.Tests</_Parameter1>
    </AssemblyAttribute>
  </ItemGroup>

</Project>
